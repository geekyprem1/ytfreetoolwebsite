{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yt-toolkit",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "SPONSOR_BOOKING_ENABLED": "false",
    "SPONSOR_PAYMENT_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "SPONSOR_DB",
      "database_name": "yt-toolkit-sponsors",
      "database_id": "27d43bad-21b7-45cd-8518-733f3fa07604",
      "migrations_dir": "migrations/sponsorship"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "yt-toolkit-cache"
    },
    {
      "binding": "SPONSOR_LOGOS",
      "bucket_name": "yt-toolkit-sponsor-logos"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "yt-toolkit"
    }
  ],
  "triggers": {
    "crons": ["15 0 * * *"]
  },
  "workers_dev": true,
  "preview_urls": true
}
