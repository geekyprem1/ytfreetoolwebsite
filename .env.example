# =============================================================================
# Required for MVP
# =============================================================================

# YouTube Data API v3
YOUTUBE_API_KEY=

# Google Gemini 2.5 Flash (Primary AI)
# Get it from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Upstash Redis
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel
CRON_SECRET=

# =============================================================================
# Analytics & Monitoring
# =============================================================================

# Sentry
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_ENABLED=false

# =============================================================================
# Site Configuration
# =============================================================================

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=YouTube Toolkit AI
NEXT_PUBLIC_SITE_DESCRIPTION=Free YouTube creator toolkit with 15+ tools. No login required.

# =============================================================================
# Feature Flags
# =============================================================================

NEXT_PUBLIC_ENABLE_AI_TOOLS=true
NEXT_PUBLIC_ENABLE_ADS=false
NEXT_PUBLIC_ENABLE_CONTACT_FORM=true
NEXT_PUBLIC_ENABLE_BLOG=true

# =============================================================================
# Optional / Future
# =============================================================================

# OpenRouter (AI Fallback — used when GEMINI_API_KEY fails or is not set)
# Get it from: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# AI_MODEL=google/gemini-2.5-flash     # Default model for OpenRouter. Uncomment and change to any model below.
#
# OpenRouter pe available models (examples):
#   google/gemini-2.5-flash          — Fast, free/cost, good for most tasks
#   google/gemini-2.5-pro            — More powerful, better reasoning
#   openai/gpt-4o                    — OpenAI's latest
#   openai/gpt-4o-mini               — Cheaper and faster
#   anthropic/claude-sonnet-4-20250514 — Deep reasoning, good for analysis
#   anthropic/claude-opus-4-20250514  — Top-tier, expensive
#   meta-llama/llama-4-maverick      — Open-source, competitive
#   deepseek/deepseek-chat           — Cheap, good for SEO tasks
#   mistralai/mistral-large          — Fast, balanced
#   qwen/qwen-max                    — Strong at structured JSON output
#
# Kaise set karna hai:
#   1. OpenRouter se API key lo: https://openrouter.ai/keys
#   2. Credits daalo (pay as you go, minimal cost)
#   3. Neeche OPENROUTER_API_KEY aur AI_MODEL set karo
#   4. GEMINI_API_KEY optional hai agar OpenRouter use kar rahe ho
